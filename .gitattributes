* text=auto
# Linux: LF obligatorio (bash falla con CRLF)
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
# Windows: CRLF (cmd.exe necesita CRLF en los .cmd/.bat)
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
# Por si alguna vez se agregan
*.png  binary
*.jpg  binary
*.ico  binary
# Archivos que no van en los ZIP de descarga (git archive / Releases)
.gitattributes export-ignore
.gitignore     export-ignore
.github        export-ignore
tools/re       export-ignore
re             export-ignore
